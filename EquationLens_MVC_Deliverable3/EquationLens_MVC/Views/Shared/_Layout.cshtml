<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - EquationLens</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400;1,600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    @* Section: page-specific CSS or meta tags *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="_Navbar" />

    @* Section: optional banner between the navbar and the page content *@
    @await RenderSectionAsync("PageHeader", required: false)

    @RenderBody()

    <partial name="_Footer" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js"></script>
    @* Section: page-specific scripts, loaded last *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
