@model AdminDashboardViewModel
@{ ViewData["Title"]="Admin overview"; }
<main class="container py-4"><h1 class="display-6 mb-1">Admin overview</h1><p class="text-muted-coffee mb-4">Live account and equation totals from the application database.</p><div class="sheet mb-4"><div class="row g-0"><div class="col-md-6 stat"><div class="num">@Model.UserCount</div><div class="text-muted-coffee">Registered users</div></div><div class="col-md-6 stat"><div class="num">@Model.EquationCount</div><div class="text-muted-coffee">Equations solved</div></div></div></div><div class="sheet"><div class="sheet-pad pb-2"><h2 class="h4 mb-0">Registered accounts</h2></div><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th class="text-end">Solved</th></tr></thead><tbody>@foreach(var user in Model.Users){<tr><td>@user.Name</td><td>@user.Email</td><td><span class="badge-role @(user.Role=="Admin"?"admin":"")">@user.Role</span></td><td class="text-end mono">@user.Solved</td></tr>}</tbody></table></div></div></main>
