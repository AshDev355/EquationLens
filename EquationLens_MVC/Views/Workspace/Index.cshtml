@model WorkspaceViewModel
@{ ViewData["Title"]="My workspace"; }
<main class="container py-4"><h1 class="display-6 mb-1">Hello, @Model.FullName.</h1><p class="text-muted-coffee mb-4">Enter an equation, review the working, and keep your solutions in one place.</p><div class="row g-4"><div class="col-lg-6"><div class="sheet sheet-pad h-100"><h2 class="h4 mb-3">1. Image preview</h2><label class="dropzone d-block mb-3" id="dropzone" for="fileInput"><span class="d-block fw-semibold" style="color:var(--yale)">Drop an image here, or click to choose</span><span class="small-mono text-muted-coffee">PNG or JPG</span><input class="visually-hidden" id="fileInput" type="file" accept="image/png,image/jpeg"></label><img id="previewImg" class="eq-img" src="~/images/eq-quadratic.png" alt="Equation preview"><p class="small text-muted-coffee mt-2 mb-0">Preview only: OCR/image-to-LaTeX recognition is not connected in this version. Type the recognized equation in the next panel.</p></div></div><div class="col-lg-6"><div class="sheet sheet-pad mb-4"><h2 class="h4 mb-3">2. Equation input</h2><form asp-action="Solve" method="post"><label class="form-label" for="equation">Linear or quadratic equation in x</label><input class="form-control mono mb-3" id="equation" name="equation" value="@Model.Equation" placeholder="2x^2 - 5x + 3 = 0" required><button class="btn btn-gold" type="submit">Solve this equation</button></form></div><div class="board"><h2 class="h4 mb-3">3. Solution</h2>@if(!string.IsNullOrWhiteSpace(Model.Error)){<p class="mb-0 text-warning">@Model.Error</p>}else if(Model.Steps?.Any()==true){<ol class="step-list mb-0">@foreach(var step in Model.Steps){<li>@step</li>}</ol>}else{<p class="mb-0">Submit an equation to see the solution steps here.</p>}</div></div><div class="col-12"><div class="sheet sheet-pad"><div class="d-flex justify-content-between align-items-baseline mb-2"><h2 class="h4 mb-0">Recent equations</h2><form asp-action="ClearHistory" method="post"><button type="submit" class="btn btn-sm btn-outline-yale">Clear history</button></form></div>@if(Model.History.Count==0){<p class="text-muted-coffee mb-0">No saved equations yet. Solve your first equation above.</p>}else{@foreach(var item in Model.History){<div class="history-item"><div class="flex-grow-1"><div class="mono">@item.Equation</div><div class="small text-muted-coffee">Solved @item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div></div><span class="answer">@item.Result</span></div>}}</div></div></div></main>
@section Scripts { <script>document.addEventListener('DOMContentLoaded',()=>{const f=document.getElementById('fileInput'),p=document.getElementById('previewImg'),d=document.getElementById('dropzone');function show(file){if(!file||!['image/png','image/jpeg'].includes(file.type))return;p.src=URL.createObjectURL(file);}f?.addEventListener('change',()=>show(f.files[0]));d?.addEventListener('dragover',e=>e.preventDefault());d?.addEventListener('drop',e=>{e.preventDefault();show(e.dataTransfer.files[0]);});});</script> }
