@{ ViewData["Title"]="Home"; }
<main><section class="container py-5"><div class="row align-items-center g-5 py-lg-4"><div class="col-lg-6"><p class="small-mono fw-semibold text-uppercase mb-3" style="color:var(--yale)">AI handwritten equation solver</p><h1 class="display-hero mb-4">From scribble to <span class="marker">solution.</span></h1><p class="fs-5 text-muted-coffee mb-4" style="max-width:32rem">Photograph a handwritten equation. EquationLens is designed to read it, turn it into LaTeX, and solve it with every step shown.</p><div class="d-flex flex-wrap gap-3"><a class="btn btn-gold btn-lg" asp-controller="Account" asp-action="Register">Get started</a><a class="btn btn-outline-yale btn-lg" href="#method">Read the method</a></div></div><div class="col-lg-6"><div class="board"><p class="label mb-2">Your photo</p><img class="eq-img mb-4" src="~/images/eq-quadratic.png" alt="Handwritten quadratic equation"><p class="label mb-2">What we read</p><p class="mono mb-4 p-2 rounded" style="background:rgba(0,0,0,.25)">2x^2 - 5x + 3 = 0</p><p class="label mb-1">Steps</p><ol class="step-list"><li>Δ = b² − 4ac = 25 − 24 = 1</li><li>x = (5 ± √1) / 4</li><li><span class="answer">x = 1 or x = 3/2</span></li></ol></div><p class="fig-cap mt-2 mb-0">Fig. 1. Photo to equation to worked solution.</p></div></div></section>
<section class="container py-5" id="method"><hr class="border-2 opacity-100" style="color:var(--yale)"><h2 class="display-6 mt-4 mb-4">Four steps, no hand-waving.</h2><div class="sheet"><div class="row g-0">@foreach(var item in new[]{("1","Upload","Add a photo of your handwritten equation.","Image input"),("2","Preprocess","Denoise and sharpen the image for recognition.","OpenCV"),("3","Recognize","Read symbols as LaTeX and allow corrections.","pix2tex, KaTeX"),("4","Solve","Return symbolic working and the answer.","SymPy")}){<div class="col-md-6 col-lg-3 method-cell"><div class="mono fw-semibold" style="color:var(--yale)">@item.Item1</div><h3 class="h4 mt-2">@item.Item2</h3><p class="text-muted-coffee mb-3">@item.Item3</p><span class="tag">@item.Item4</span></div>}</div></div></section>
<section class="container pb-5" id="stack"><div class="row g-4"><div class="col-lg-7"><div class="theorem h-100"><p class="small-mono fw-semibold mb-2" style="color:var(--yale)">Current prototype scope</p><p class="fs-4 fst-italic mb-3">The current MVC demo solves supported linear and quadratic equations in x and stores each user's solution history.</p><p class="mb-0 text-muted-coffee">Image recognition is a separate integration and is not connected yet.</p></div></div><div class="col-lg-5"><div class="coffee-panel h-100 d-flex flex-column justify-content-center"><p class="label mb-2">Quadratic formula</p><p class="fs-3 fst-italic mb-0">x = (−b ± √(b² − 4ac)) / 2a</p></div></div></div></section><section class="container pb-5"><div class="cta-band d-flex flex-wrap justify-content-between align-items-center gap-4"><h2 class="display-6 mb-0" style="max-width:34rem">Stop retyping equations. <span class="accent">Start solving them.</span></h2><a class="btn btn-gold btn-lg" asp-controller="Account" asp-action="Register">Create free account</a></div></section></main>
