<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>@ViewData["Title"] - EquationLens</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400;1,600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="~/css/style.css" rel="stylesheet"></head><body>
<header class="site-nav"><nav class="navbar navbar-expand-lg container py-3"><a class="brand" asp-controller="Home" asp-action="Index"><span class="sigma">&sum;</span>EquationLens</a><button class="navbar-toggler border-2" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav mx-auto gap-lg-3"><li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li><li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="method">Method</a></li><li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="stack">Stack</a></li></ul><div class="d-flex gap-2 align-items-center">@if(User.Identity?.IsAuthenticated==true){<span class="small-mono">@User.Identity.Name</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-yale" type="submit">Log out</button></form>}else{<a class="btn btn-outline-yale" asp-controller="Account" asp-action="Login">Log in</a><a class="btn btn-yale" asp-controller="Account" asp-action="Register">Sign up</a>}</div></div></nav></header>
@RenderBody()<footer class="container site-footer py-4 d-flex justify-content-between flex-wrap gap-2"><span>&copy; @DateTime.Now.Year EquationLens</span><span><a asp-controller="Account" asp-action="Login">Log in</a> &middot; <a asp-controller="Account" asp-action="Register">Sign up</a></span></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/main.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
